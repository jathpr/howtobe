---
import { languageNames, locales } from '../i18n/ui';
---

<!doctype html>
<html lang="be" data-locales={locales.join(',')}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Choose a language — howtobe</title>
		<script is:inline>
			const supportedLocales = document.documentElement.dataset.locales.split(',');
			const preferredLanguages = navigator.languages?.length
				? navigator.languages
				: [navigator.language];
			const locale = preferredLanguages
				.map((language) => language.toLowerCase().split(/[-_]/)[0])
				.find((language) => supportedLocales.includes(language)) ?? 'be';

			window.location.replace(`/${locale}/`);
		</script>
		<style>
			:root {
				font-family: system-ui, sans-serif;
				color: #20201e;
				background: #f5f3ed;
				font-synthesis: none;
			}

			* {
				box-sizing: border-box;
			}

			body {
				display: grid;
				min-width: 320px;
				min-height: 100vh;
				margin: 0;
				place-items: center;
			}

			main {
				width: min(100% - 3rem, 32rem);
				padding-block: 3rem;
			}

			h1 {
				margin: 0 0 2rem;
				font-size: 1rem;
				font-weight: 400;
			}

			nav {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem 1.5rem;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Выберыце мову · Выберите язык · Choose a language</h1>
			<nav aria-label="Language">
				{locales.map((locale) => (
					<a href={`/${locale}/`} lang={locale}>{languageNames[locale]}</a>
				))}
			</nav>
		</main>
	</body>
</html>
