---
const siteName = 'howtobe';
---

<!doctype html>
<html lang="be">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Асабісты сайт Міці." />
		<title>{siteName}</title>
	</head>
	<body>
		<main>
			<p class="eyebrow">{siteName}</p>
			<h1>Вітаю.</h1>
			<p class="intro">Гэта пачатак новага сайта.</p>
		</main>
	</body>
</html>

<style>
	:root {
		font-family: Georgia, 'Times New Roman', serif;
		color: #20201e;
		background: #f5f3ed;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-width: 320px;
		min-height: 100vh;
		margin: 0;
	}

	main {
		display: grid;
		align-content: center;
		min-height: 100vh;
		width: min(100% - 3rem, 52rem);
		margin-inline: auto;
		padding-block: 4rem;
	}

	.eyebrow {
		margin: 0 0 2rem;
		font-family: system-ui, sans-serif;
		font-size: 0.8rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(4rem, 14vw, 9rem);
		font-weight: 400;
		letter-spacing: -0.07em;
		line-height: 0.95;
	}

	.intro {
		max-width: 28rem;
		margin: 2rem 0 0;
		font-size: clamp(1.15rem, 2.8vw, 1.5rem);
		line-height: 1.5;
	}
</style>
