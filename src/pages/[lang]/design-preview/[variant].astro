---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { designVariants, type DesignVariant } from '../../../lib/design-preview';

export function getStaticPaths() {
	return designVariants.map((variant) => ({
		params: { lang: 'be', variant: variant.slug },
		props: { variant },
	}));
}

interface Props {
	variant: DesignVariant;
}

const { variant } = Astro.props;
---

<SiteLayout
	locale="be"
	title={`Эскіз: ${variant.title}`}
	description="Тры эксперыментальныя кірункі дызайну асабістага сайта."
	showChrome={false}
>
	<div class={`preview theme-${variant.slug}`}>
		<header class="topbar">
			<a class="wordmark" href="/be/">howtobe</a>
			<span class="preview-label">Эскіз · {variant.title}</span>
		</header>

		<nav class="variant-picker" aria-label="Варыянты дызайну">
			{designVariants.map((item) => (
				<a
					href={`/be/design-preview/${item.slug}/`}
					aria-current={item.slug === variant.slug ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>

		<main>
			<section class="welcome">
				<p class="eyebrow">Асабісты сайт · Міця</p>
				<h1>Вітаю.</h1>
				<p class="intro">
					Гэта прастора для думак, практыкі і невялікіх адкрыццяў.
				</p>
				<a class="journey-link" href="/be/awareness/">Прысутнасць <span aria-hidden="true">↗</span></a>
			</section>

			<svg
				class="sailing-mark"
				viewBox="0 0 260 160"
				fill="none"
				role="img"
				aria-labelledby="scene-title"
			>
				<title id="scene-title">Маленькі човен плыве да месяца</title>
				<circle class="moon" cx="211" cy="43" r="20" />
				<path class="moon-path" d="M37 118c46 4 89-2 119-18 17-9 29-20 39-34" />
				<path class="boat-hull" d="M79 112h57l-11 13H92l-13-13Z" />
				<path class="boat-mast" d="M108 110V70" />
				<path class="boat-sail" d="M104 74 83 105h21V74Zm5 3 19 28h-19V77Z" />
				<path class="waterline" d="M64 132c18-4 33-4 48 0 15 4 30 4 48 0" />
			</svg>
		</main>

		<footer>
			<span>Тэорыя · Практыка · Досвед</span>
			<div class="languages" aria-label="Мовы сайта">
				<a href="/be/" aria-current="page">BE</a>
				<a href="/ru/">RU</a>
				<a href="/en/">EN</a>
			</div>
		</footer>
	</div>
</SiteLayout>

<style>
	.preview {
		--ink: #292720;
		--muted: #716e64;
		--accent: #8d7555;
		--seam: transparent;
		--grain: transparent;
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		overflow: hidden;
		padding: clamp(1.25rem, 4vw, 3rem) clamp(1.25rem, 7vw, 7rem);
		color: var(--ink);
		background-color: #fffefa;
		background-image: var(--seam), var(--grain);
	}

	.theme-ink {
		--ink: #f0efeb;
		--muted: #c2c2c0;
		--accent: #c3ad89;
		background-color: #25272b;
		--grain:
			radial-gradient(ellipse at 18% 44%, rgb(200 195 150 / 4%), transparent 28%),
			radial-gradient(ellipse at 84% 78%, rgb(200 195 150 / 3%), transparent 24%);
		background-image: var(--grain);
		background-size: 100% 100%, 100% 100%;
	}

	.theme-sand {
		--ink: #302c25;
		--muted: #746b5c;
		--accent: #8b6c42;
		background-color: #e9dfcc;
		background-image:
			radial-gradient(ellipse at 82% 18%, rgb(255 255 255 / 38%), transparent 29%),
			linear-gradient(145deg, rgb(255 255 255 / 22%), transparent 62%);
	}

	.theme-kraft {
		--ink: #342b20;
		--muted: #705b43;
		--accent: #795b37;
		background-color: #c7a77b;
		background-image:
			radial-gradient(ellipse at 82% 18%, rgb(255 244 220 / 22%), transparent 32%),
			radial-gradient(ellipse at 16% 78%, rgb(105 76 41 / 8%), transparent 35%),
			linear-gradient(145deg, rgb(255 247 226 / 12%), transparent 62%);
	}

	.theme-white {
		--ink: #242424;
		--muted: #777;
		--accent: #555;
		background-color: #fff;
		background-image: none;
	}

	.topbar,
	footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: system-ui, sans-serif;
	}

	.wordmark {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.05rem;
		letter-spacing: -0.04em;
		text-decoration: none;
	}

	.preview-label,
	footer {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
	}

	.variant-picker {
		position: absolute;
		z-index: 1;
		top: clamp(4.5rem, 11vh, 7rem);
		left: 50%;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.35rem;
		max-width: calc(100% - 2.5rem);
		padding: 0.3rem;
		border: 1px solid rgb(70 65 54 / 12%);
		border-radius: 999px;
		background: rgb(255 255 255 / 46%);
		backdrop-filter: blur(12px);
		transform: translateX(-50%);
		font-family: system-ui, sans-serif;
		font-size: 0.78rem;
	}

	.variant-picker a {
		padding: 0.48rem 0.85rem;
		border-radius: 999px;
		color: var(--muted);
		text-decoration: none;
		transition: color 160ms ease, background-color 160ms ease;
	}

	.variant-picker a:hover,
	.variant-picker a[aria-current='page'] {
		color: var(--ink);
		background: rgb(255 255 255 / 72%);
	}

	.theme-ink .variant-picker {
		border-color: rgb(255 255 255 / 14%);
		background: rgb(12 14 12 / 42%);
	}

	.theme-ink .variant-picker a:hover,
	.theme-ink .variant-picker a[aria-current='page'] {
		color: #252720;
		background: rgb(242 239 225 / 92%);
	}

	main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(150px, 260px);
		align-items: center;
		gap: clamp(1rem, 5vw, 4rem);
		width: min(100%, 68rem);
		flex: 1;
		margin: 0 auto;
		padding-block: clamp(7rem, 19vh, 12rem) clamp(3rem, 10vh, 7rem);
	}

	.welcome {
		max-width: 39rem;
	}

	.eyebrow {
		margin: 0 0 1.6rem;
		color: var(--muted);
		font-family: system-ui, sans-serif;
		font-size: 0.72rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(4.5rem, 12vw, 9.5rem);
		font-weight: 400;
		letter-spacing: -0.075em;
		line-height: 0.95;
	}

	.intro {
		max-width: 31rem;
		margin: 2rem 0 0;
		color: var(--muted);
		font-size: clamp(1.1rem, 2.2vw, 1.45rem);
		line-height: 1.55;
	}

	.journey-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 2.3rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
		color: var(--ink);
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		text-decoration: none;
		transition: gap 160ms ease;
	}

	.journey-link:hover {
		gap: 0.9rem;
	}

	.journey-link span {
		color: var(--accent);
	}

	.sailing-mark {
		width: 100%;
		max-width: 245px;
		justify-self: end;
		overflow: visible;
	}

	.moon {
		fill: rgb(255 255 255 / 52%);
		stroke: var(--accent);
		stroke-width: 1.3;
	}

	.moon-path {
		stroke: color-mix(in srgb, var(--accent) 35%, transparent);
		stroke-width: 1;
		stroke-dasharray: 2 6;
	}

	.boat-hull,
	.boat-sail {
		fill: color-mix(in srgb, var(--accent) 13%, transparent);
		stroke: var(--accent);
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.boat-mast,
	.waterline {
		stroke: var(--accent);
		stroke-linecap: round;
		stroke-width: 1.4;
	}

	.waterline {
		opacity: 0.56;
	}

	footer {
		width: min(100%, 68rem);
		margin-inline: auto;
		padding-top: 1rem;
		border-top: 1px solid color-mix(in srgb, var(--muted) 20%, transparent);
		letter-spacing: 0.04em;
	}

	.languages {
		display: flex;
		gap: 0.85rem;
	}

	.languages a {
		text-decoration: none;
		text-underline-offset: 0.25em;
	}

	.languages a[aria-current='page'] {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	@media (max-width: 600px) {
		.preview {
			padding-inline: 1.35rem;
		}

		.preview-label {
			font-size: 0.65rem;
		}

		.variant-picker {
			top: 5.1rem;
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			width: min(100% - 2.5rem, 24rem);
			gap: 0.15rem;
			font-size: 0.68rem;
			text-align: center;
		}

		.variant-picker a {
			padding-inline: 0.3rem;
		}

		main {
			grid-template-columns: 1fr;
			gap: 1.2rem;
			padding-block: 9.5rem 2.5rem;
		}

		h1 {
			font-size: clamp(4.25rem, 19vw, 7rem);
		}

		.intro {
			margin-top: 1.4rem;
		}

		.journey-link {
			margin-top: 1.8rem;
		}

		.sailing-mark {
			width: 145px;
			max-width: 32vw;
			margin-top: 0.2rem;
		}

		footer {
			font-size: 0.64rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.variant-picker a,
		.journey-link {
			transition: none;
		}
	}
</style>
