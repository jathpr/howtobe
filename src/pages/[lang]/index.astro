---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import { locales, type Locale } from '../../i18n/ui';

interface Props {
	locale: Locale;
}

export function getStaticPaths() {
	return locales.map((locale) => ({
		params: { lang: locale },
		props: { locale },
	}));
}

const { locale } = Astro.props;
const homePage = (await getCollection('pages')).find((entry) => entry.id === `${locale}/home`);
if (!homePage) {
	throw new Error(`Missing home page content for locale "${locale}".`);
}
const { Content } = await render(homePage);
---

<SiteLayout locale={locale} title={homePage.data.title} description={homePage.data.description}>
	<main class="home-page">
		<section class="welcome">
			<p class="eyebrow">{locale === 'be' ? 'Асабісты сайт · Міця' : locale === 'ru' ? 'Личный сайт · Митя' : 'Personal site · Mitya'}</p>
			<h1>{homePage.data.title}</h1>
			<div class="home-copy">
				<Content />
			</div>
		</section>

		<svg
			class="sailing-mark"
			viewBox="0 0 260 160"
			fill="none"
			role="img"
			aria-labelledby="scene-title"
		>
			<title id="scene-title">
				{locale === 'be'
					? 'Маленькі човен плыве да месяца'
					: locale === 'ru'
						? 'Маленькая лодка плывёт к луне'
						: 'A little boat sailing toward the moon'}
			</title>
			<circle class="moon" cx="211" cy="43" r="20" />
			<path class="moon-path" d="M37 118c46 4 89-2 119-18 17-9 29-20 39-34" />
			<g class="boat">
				<path class="boat-hull" d="M79 112h57l-11 13H92l-13-13Z" />
				<path class="boat-mast" d="M108 110V70" />
				<path class="boat-sail" d="M104 74 83 105h21V74Zm5 3 19 28h-19V77Z" />
				<path class="waterline" d="M64 132c18-4 33-4 48 0 15 4 30 4 48 0" />
			</g>
		</svg>
	</main>
</SiteLayout>

<style>
	.home-page {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(150px, 260px);
		align-items: center;
		gap: clamp(1rem, 5vw, 4rem);
		width: min(100%, 68rem);
		flex: 1;
		margin-inline: auto;
		padding-block: clamp(7rem, 19vh, 12rem) clamp(3rem, 10vh, 7rem);
	}

	.welcome {
		max-width: 39rem;
	}

	.eyebrow {
		margin: 0 0 1.6rem;
		color: var(--muted);
		font-family: system-ui, sans-serif;
		font-size: 0.72rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(4.5rem, 12vw, 9.5rem);
		font-weight: 400;
		letter-spacing: -0.075em;
		line-height: 0.95;
	}

	.home-copy {
		max-width: 34rem;
		margin-top: 2rem;
		color: var(--muted);
		font-size: clamp(1.1rem, 2.2vw, 1.45rem);
		line-height: 1.55;
	}

	.home-copy :global(p) {
		margin: 0 0 1rem;
	}

	:global(.home-copy .journey-link) {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 2.3rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
		font-family: system-ui, sans-serif;
		font-size: 0.95rem;
		text-decoration: none;
		transition: gap 160ms ease;
	}

	:global(.home-copy .journey-link:hover) {
		gap: 0.9rem;
	}

	:global(.home-copy .journey-link span) {
		color: var(--accent);
	}

	.sailing-mark {
		width: 100%;
		max-width: 245px;
		justify-self: end;
		overflow: visible;
	}

	.moon {
		fill: rgb(255 255 255 / 52%);
		stroke: var(--accent);
		stroke-width: 1.3;
	}

	.moon-path {
		stroke: color-mix(in srgb, var(--accent) 35%, transparent);
		stroke-width: 1;
		stroke-dasharray: 2 6;
	}

	.boat {
		transform-box: fill-box;
		transform-origin: center;
		animation: boat-drift 7min linear infinite alternate;
	}

	@keyframes boat-drift {
		from {
			transform: translateX(-34px);
		}

		to {
			transform: translateX(38px);
		}
	}

	.boat-hull,
	.boat-sail {
		fill: color-mix(in srgb, var(--accent) 13%, transparent);
		stroke: var(--accent);
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.boat-mast,
	.waterline {
		stroke: var(--accent);
		stroke-linecap: round;
		stroke-width: 1.4;
	}

	.waterline {
		opacity: 0.56;
	}

	@media (max-width: 600px) {
		.home-page {
			grid-template-columns: 1fr;
			gap: 1.2rem;
			padding-block: clamp(6rem, 18vh, 9.5rem) 2.5rem;
		}

		h1 {
			font-size: clamp(4.25rem, 19vw, 7rem);
		}

		.intro {
			margin-top: 1.4rem;
		}

		.journey-link {
			margin-top: 1.8rem;
		}

		.sailing-mark {
			width: 145px;
			max-width: 32vw;
			margin-top: 0.2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.home-copy .journey-link) {
			transition: none;
		}

		.boat {
			animation: none;
			transform: none;
		}
	}
</style>
