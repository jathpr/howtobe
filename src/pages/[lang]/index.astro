---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { languageNames, locales, messages, type Locale } from '../../i18n/ui';

interface Props {
	locale: Locale;
}

export function getStaticPaths() {
	return locales.map((locale) => ({
		params: { lang: locale },
		props: { locale },
	}));
}

const { locale } = Astro.props;
const page = messages[locale];
---

<SiteLayout locale={locale} title={page.title} description={page.description}>
	<main>
		<p class="eyebrow">howtobe</p>
		<h1>{page.title}</h1>
		<p class="intro">{page.intro}</p>

		<nav aria-label={page.languageSelection}>
			{locales.map((language) => (
				<a href={`/${language}/`} lang={language} aria-current={language === locale ? 'page' : undefined}>
					{languageNames[language]}
				</a>
			))}
		</nav>
	</main>
</SiteLayout>

<style>
	main {
		display: grid;
		align-content: center;
		min-height: 100vh;
		width: min(100% - 3rem, 52rem);
		margin-inline: auto;
		padding-block: 4rem;
	}

	.eyebrow {
		margin: 0 0 2rem;
		font-family: system-ui, sans-serif;
		font-size: 0.8rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(4rem, 14vw, 9rem);
		font-weight: 400;
		letter-spacing: -0.07em;
		line-height: 0.95;
	}

	.intro {
		max-width: 28rem;
		margin: 2rem 0 0;
		font-size: clamp(1.15rem, 2.8vw, 1.5rem);
		line-height: 1.5;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin-top: 3rem;
		font-family: system-ui, sans-serif;
		font-size: 0.9rem;
	}

	nav a {
		text-underline-offset: 0.25em;
	}

	nav a[aria-current='page'] {
		text-decoration-thickness: 2px;
	}
</style>
